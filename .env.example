# Password halaman /admin (WAJIB diisi, kalau kosong /admin nggak bisa dibuka)
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Rahasia penandatangan sesi login. Kalau kosong dibuat otomatis di data/.session-secret
# SESSION_SECRET=

# Lokasi database SQLite (default: file:./data/switch.db, relatif ke folder proyek).
# Bisa juga database Turso: libsql://nama-db.turso.io?authToken=...
# DATABASE_URL=file:./data/switch.db
